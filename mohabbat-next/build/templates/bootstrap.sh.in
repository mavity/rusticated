# No shebang: the MZ DOS stub evaluates this appended script.
set -eu

if command -v realpath >/dev/null 2>&1; then
    ME="$(realpath "$0")"
else
    case "$0" in
        /*) ME="$0" ;;
        *) ME="$PWD/$0" ;;
    esac
fi

SYSTEM="$(uname -s)"
ARCH="$(uname -m)"
[ "$ARCH" = arm64 ] && ARCH=aarch64

case "$SYSTEM" in
    Linux)
        if [ -n "${TERMUX_VERSION:-}" ] || [ "${PREFIX:-}" = /data/data/com.termux/files/usr ]; then
            SYSTEM=android
        else
            SYSTEM=linux
        fi
        ;;
    Darwin) SYSTEM=darwin ;;
    *) echo "Unsupported platform: $SYSTEM $ARCH" >&2; exit 1 ;;
esac

run() {
    b_off="$1"; b_len="$2"; pool_off="$3"; pool_len="$4"
    shift 4

    tmp_dir="${TMPDIR:-${PREFIX:+$PREFIX/tmp}}"
    tmp_dir="${tmp_dir:-/tmp}"
    [ -d "$tmp_dir" ] && [ -w "$tmp_dir" ] || { echo "Temporary directory not writable: $tmp_dir" >&2; exit 2; }

    umask 077
    tmp_exe="$(mktemp "$tmp_dir/🐚︎XXXXXXXXXXXX")" || { echo "Could not create launcher in $tmp_dir" >&2; exit 1; }
    trap 'rm -f "$tmp_exe"' EXIT

    tail -c "+$((b_off + 1))" "$ME" | head -c "$b_len" > "$tmp_exe"
    [ -s "$tmp_exe" ] || { echo "brot: failed to extract launcher into $tmp_exe from $ME" >&2; exit 3; }
    chmod 700 "$tmp_exe"
    exec "$tmp_exe" "$ME" "$pool_off" "$pool_len" "$@"
}

case "$SYSTEM/$ARCH" in
    linux/x86_64)    run {{.BrotLinuxX86_64Offset}} {{.BrotLinuxX86_64Length}} {{.PoolOffset}} {{.PoolLength}} "$@" ;;
    linux/aarch64)   run {{.BrotLinuxAarch64Offset}} {{.BrotLinuxAarch64Length}} {{.PoolOffset}} {{.PoolLength}} "$@" ;;
    android/aarch64) run {{.BrotAndroidAarch64Offset}} {{.BrotAndroidAarch64Length}} {{.PoolOffset}} {{.PoolLength}} "$@" ;;
    darwin/x86_64)   run {{.BrotDarwinX86_64Offset}} {{.BrotDarwinX86_64Length}} {{.PoolOffset}} {{.PoolLength}} "$@" ;;
    darwin/aarch64)  run {{.BrotDarwinAarch64Offset}} {{.BrotDarwinAarch64Length}} {{.PoolOffset}} {{.PoolLength}} "$@" ;;
    *) echo "Unsupported target: $SYSTEM/$ARCH" >&2; exit 1 ;;
esac
exit 1
